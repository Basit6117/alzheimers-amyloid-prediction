# Copy to .env and set your own key. Do not commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override only if your Gemini account uses a different available model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Used only when Gemini returns a transient capacity or rate-limit error.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Maximum wait for the external answer-generation call.
GEMINI_TIMEOUT_SECONDS=45
# Retry transient Gemini service errors once before showing the unavailable message.
GEMINI_RETRY_ATTEMPTS=2
